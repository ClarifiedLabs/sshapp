+    /// Returns resolved grid padding in renderer pixels.
+    export fn ghostty_surface_grid_padding(
+        surface: *Surface,
+        left: *u32,
+        top: *u32,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        left.* = core_surface.size.padding.left;
+        top.* = core_surface.size.padding.top;
+        return true;
+    }
+
+    /// Returns true when the specified surface position belongs to the
+    /// selection, including selections clipped by the current viewport.
+    export fn ghostty_surface_selection_contains(
+        surface: *Surface,
+        x: f64,
+        y: f64,
+    ) bool {
+        const core_surface = &surface.core_surface;
+        core_surface.renderer_state.mutex.lock();
+        defer core_surface.renderer_state.mutex.unlock();
+
+        const screen = core_surface.io.terminal.screens.active;
+        const selection = screen.selection orelse return false;
+        const pixels = surface.cursorPosToPixels(.{
+            .x = @floatCast(x),
+            .y = @floatCast(y),
+        }) catch return false;
+        const point = core_surface.posToViewport(pixels.x, pixels.y);
+        const pin = screen.pages.pin(.{
+            .viewport = .{
+                .x = point.x,
+                .y = point.y,
+            },
+        }) orelse return false;
+
+        return selection.contains(screen, pin);
+    }
