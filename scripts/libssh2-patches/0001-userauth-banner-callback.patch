diff --git a/tests/test_userauth_banner_callback.c b/tests/test_userauth_banner_callback.c
new file mode 100644
index 00000000..5d30ec36
--- /dev/null
+++ b/tests/test_userauth_banner_callback.c
@@ -0,0 +1,245 @@
+/* Copyright (C) The libssh2 project and its contributors.
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#include "libssh2_priv.h"
+#include "packet.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define MAX_BANNERS 8
+#define MAX_FIELD_LENGTH 64
+
+struct banner_record {
+    unsigned char message[MAX_FIELD_LENGTH];
+    size_t message_length;
+    unsigned char language[MAX_FIELD_LENGTH];
+    size_t language_length;
+};
+
+struct banner_context {
+    struct banner_record records[MAX_BANNERS];
+    size_t count;
+};
+
+static LIBSSH2_USERAUTH_BANNER_FUNC(record_banner)
+{
+    struct banner_context *context;
+    struct banner_record *record;
+    (void)session;
+
+    if(!abstract || !*abstract)
+        return;
+    context = (struct banner_context *)*abstract;
+    if(context->count >= MAX_BANNERS ||
+       message_length > MAX_FIELD_LENGTH ||
+       language_length > MAX_FIELD_LENGTH)
+        return;
+
+    record = &context->records[context->count++];
+    record->message_length = message_length;
+    record->language_length = language_length;
+    if(message_length)
+        memcpy(record->message, message, message_length);
+    if(language_length)
+        memcpy(record->language, language, language_length);
+}
+
+static unsigned char *make_banner(LIBSSH2_SESSION *session,
+                                  const unsigned char *message,
+                                  size_t message_length,
+                                  const unsigned char *language,
+                                  size_t language_length,
+                                  size_t *packet_length)
+{
+    unsigned char *packet;
+    unsigned char *cursor;
+
+    *packet_length = 1 + 4 + message_length + 4 + language_length;
+    packet = LIBSSH2_ALLOC(session, *packet_length);
+    if(!packet)
+        return NULL;
+
+    cursor = packet;
+    *cursor++ = SSH_MSG_USERAUTH_BANNER;
+    _libssh2_store_u32(&cursor, (uint32_t)message_length);
+    if(message_length) {
+        memcpy(cursor, message, message_length);
+        cursor += message_length;
+    }
+    _libssh2_store_u32(&cursor, (uint32_t)language_length);
+    if(language_length)
+        memcpy(cursor, language, language_length);
+    return packet;
+}
+
+static int add_banner(LIBSSH2_SESSION *session,
+                      const unsigned char *message, size_t message_length,
+                      const unsigned char *language, size_t language_length)
+{
+    unsigned char *packet;
+    size_t packet_length;
+
+    packet = make_banner(session, message, message_length,
+                         language, language_length, &packet_length);
+    if(!packet)
+        return LIBSSH2_ERROR_ALLOC;
+    return _libssh2_packet_add(session, packet, packet_length,
+                               LIBSSH2_MAC_CONFIRMED, 0);
+}
+
+static int take_banner(LIBSSH2_SESSION *session,
+                       const unsigned char *expected, size_t expected_length)
+{
+    unsigned char *packet = NULL;
+    size_t packet_length = 0;
+    int rc = _libssh2_packet_ask(session, SSH_MSG_USERAUTH_BANNER,
+                                 &packet, &packet_length, 0, NULL, 0);
+    if(rc || packet_length != expected_length ||
+       memcmp(packet, expected, expected_length)) {
+        fprintf(stderr, "banner packet was consumed or changed\n");
+        if(!rc)
+            LIBSSH2_FREE(session, packet);
+        return 1;
+    }
+    LIBSSH2_FREE(session, packet);
+    return 0;
+}
+
+static int add_malformed(LIBSSH2_SESSION *session,
+                         const unsigned char *bytes, size_t length)
+{
+    unsigned char *packet = LIBSSH2_ALLOC(session, length);
+    if(!packet)
+        return LIBSSH2_ERROR_ALLOC;
+    memcpy(packet, bytes, length);
+    return _libssh2_packet_add(session, packet, length,
+                               LIBSSH2_MAC_CONFIRMED, 0);
+}
+
+#define CHECK(condition, message) \
+    do { if(!(condition)) { fprintf(stderr, "%s\n", (message)); return 1; } } while(0)
+
+int main(void)
+{
+    static const unsigned char first_message[] =
+        "Approve at https://example.com/a";
+    static const unsigned char first_language[] = "en-US";
+    static const unsigned char second_message[] = {'o', 'k', '\0', 'n', 'o', 'w'};
+    static const unsigned char malformed[][10] = {
+        {SSH_MSG_USERAUTH_BANNER},
+        {SSH_MSG_USERAUTH_BANNER, 0, 0, 0},
+        {SSH_MSG_USERAUTH_BANNER, 0, 0, 0, 4, 'x'},
+        {SSH_MSG_USERAUTH_BANNER, 0, 0, 0, 0},
+        {SSH_MSG_USERAUTH_BANNER, 0, 0, 0, 0, 0, 0, 0},
+        {SSH_MSG_USERAUTH_BANNER, 0, 0, 0, 0, 0, 0, 0, 2, 'x'},
+        {SSH_MSG_USERAUTH_BANNER, 0, 0, 0, 0, 0, 0, 0, 0, 'x'}
+    };
+    static const size_t malformed_lengths[] = {1, 4, 6, 5, 8, 10, 10};
+    struct banner_context context;
+    LIBSSH2_SESSION *session;
+    libssh2_cb_generic *old_callback;
+    unsigned char *expected;
+    size_t expected_length;
+    size_t i;
+    int rc;
+
+    memset(&context, 0, sizeof(context));
+    rc = libssh2_init(LIBSSH2_INIT_NO_CRYPTO);
+    CHECK(rc == 0, "libssh2_init failed");
+
+    session = libssh2_session_init();
+    CHECK(session != NULL, "libssh2_session_init failed");
+    session->state = 0;
+    *libssh2_session_abstract(session) = &context;
+
+    old_callback = libssh2_session_callback_set2(
+        session, LIBSSH2_CALLBACK_USERAUTH_BANNER,
+        (libssh2_cb_generic *)record_banner);
+    CHECK(old_callback == NULL, "unexpected prior callback");
+
+    expected = make_banner(session, first_message, sizeof(first_message) - 1,
+                           first_language, sizeof(first_language) - 1,
+                           &expected_length);
+    CHECK(expected != NULL, "packet allocation failed");
+    rc = add_banner(session, first_message, sizeof(first_message) - 1,
+                    first_language, sizeof(first_language) - 1);
+    CHECK(rc == 0, "first banner add failed");
+    CHECK(context.count == 1, "first callback missing");
+    CHECK(context.records[0].message_length == sizeof(first_message) - 1,
+          "message length changed");
+    CHECK(!memcmp(context.records[0].message, first_message,
+                  sizeof(first_message) - 1), "message bytes changed");
+    CHECK(context.records[0].language_length == sizeof(first_language) - 1,
+          "language length changed");
+    CHECK(!memcmp(context.records[0].language, first_language,
+                  sizeof(first_language) - 1), "language bytes changed");
+    CHECK(take_banner(session, expected, expected_length) == 0,
+          "first banner not queued");
+    LIBSSH2_FREE(session, expected);
+
+    rc = add_banner(session, second_message, sizeof(second_message), NULL, 0);
+    CHECK(rc == 0, "second banner add failed");
+    rc = add_banner(session, second_message, sizeof(second_message), NULL, 0);
+    CHECK(rc == 0, "repeated banner add failed");
+    CHECK(context.count == 3, "ordered repeated callbacks missing");
+    CHECK(context.records[1].message_length == sizeof(second_message) &&
+          context.records[2].message_length == sizeof(second_message),
+          "embedded-NUL length changed");
+    CHECK(!memcmp(context.records[1].message, second_message,
+                  sizeof(second_message)) &&
+          !memcmp(context.records[2].message, second_message,
+                  sizeof(second_message)), "repeated message bytes changed");
+    expected = make_banner(session, second_message, sizeof(second_message),
+                           NULL, 0, &expected_length);
+    CHECK(expected != NULL, "packet allocation failed");
+    CHECK(take_banner(session, expected, expected_length) == 0,
+          "second banner not queued");
+    CHECK(take_banner(session, expected, expected_length) == 0,
+          "repeated banner not queued");
+    LIBSSH2_FREE(session, expected);
+
+    for(i = 0; i < sizeof(malformed_lengths) / sizeof(malformed_lengths[0]); i++) {
+        size_t count_before = context.count;
+        rc = add_malformed(session, malformed[i], malformed_lengths[i]);
+        CHECK(rc == 0, "malformed packet add failed");
+        CHECK(context.count == count_before,
+              "malformed banner invoked callback");
+        CHECK(take_banner(session, malformed[i], malformed_lengths[i]) == 0,
+              "malformed banner not queued unchanged");
+    }
+
+    session->userauth_pswd_state = libssh2_NB_state_sent;
+    rc = add_banner(session, (const unsigned char *)"during-password", 15,
+                    (const unsigned char *)"", 0);
+    CHECK(rc == 0 && context.count == 4,
+          "callback missing during another authentication method");
+    expected = make_banner(session, (const unsigned char *)"during-password", 15,
+                           (const unsigned char *)"", 0, &expected_length);
+    CHECK(expected != NULL, "packet allocation failed");
+    CHECK(take_banner(session, expected, expected_length) == 0,
+          "method banner not queued");
+    LIBSSH2_FREE(session, expected);
+
+    session->state |= LIBSSH2_STATE_AUTHENTICATED;
+    rc = add_banner(session, (const unsigned char *)"too late", 8, NULL, 0);
+    CHECK(rc == 0, "post-auth banner add failed");
+    CHECK(context.count == 4, "post-auth callback must not run");
+    expected = make_banner(session, (const unsigned char *)"too late", 8,
+                           NULL, 0, &expected_length);
+    CHECK(expected != NULL, "packet allocation failed");
+    CHECK(take_banner(session, expected, expected_length) == 0,
+          "post-auth banner not queued");
+    LIBSSH2_FREE(session, expected);
+
+    old_callback = libssh2_session_callback_set2(
+        session, LIBSSH2_CALLBACK_USERAUTH_BANNER, NULL);
+    CHECK(old_callback == (libssh2_cb_generic *)record_banner,
+          "callback replacement did not return prior callback");
+
+    libssh2_session_free(session);
+    libssh2_exit();
+    return 0;
+}
