+pub fn grid_ref_hyperlink_equal(
+    a_: ?*const CGridRef,
+    b_: ?*const CGridRef,
+    out_: ?*bool,
+) callconv(lib.calling_conv) Result {
+    if (comptime !lib.feature(.grid_introspection)) return .unsupported;
+    const a = a_ orelse return .invalid_value;
+    const b = b_ orelse return .invalid_value;
+    const out = out_ orelse return .invalid_value;
+    out.* = false;
+    const ap = a.toPin() orelse return .invalid_value;
+    const bp = b.toPin() orelse return .invalid_value;
+    const ac = ap.rowAndCell().cell;
+    const bc = bp.rowAndCell().cell;
+    if (!ac.hyperlink or !bc.hyperlink) return .success;
+    const page_a = ap.node.page();
+    const page_b = bp.node.page();
+    const aid = page_a.lookupHyperlink(ac) orelse return .success;
+    const bid = page_b.lookupHyperlink(bc) orelse return .success;
+    const first = page_a.hyperlink_set.get(page_a.memory, aid);
+    const second = page_b.hyperlink_set.get(page_b.memory, bid);
+    out.* = first.eql(page_a.memory, second, page_b.memory);
+    return .success;
+}
