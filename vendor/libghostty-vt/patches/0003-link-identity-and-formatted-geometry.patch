+test "grid_ref_hyperlink_equal validates pointers and compares OSC 8 identity" {
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &t, 8, 2));
+    defer terminal_c.free(t);
+    const input = "\x1b]8;id=a;https://example.com\x1b\\A\x1b]8;;\x1b\\" ++
+        "\r\n\r\n\x1b]8;id=a;https://example.com\x1b\\B\x1b]8;id=b;https://example.com\x1b\\C\x1b]8;;\x1b\\D";
+    terminal_c.vt_write(t, input.ptr, input.len);
+    const pages = &t.?.terminal.screens.active.pages;
+    const a = CGridRef.fromPin(pages.pin(.{ .screen = .{} }).?);
+    const b = CGridRef.fromPin(pages.pin(.{ .active = .{ .y = 1 } }).?);
+    const c = CGridRef.fromPin(pages.pin(.{ .active = .{ .x = 1, .y = 1 } }).?);
+    const missing = CGridRef.fromPin(pages.pin(.{ .active = .{ .x = 2, .y = 1 } }).?);
+    var equal = true;
+    try testing.expectEqual(Result.invalid_value, grid_ref_hyperlink_equal(null, &b, &equal));
+    try testing.expectEqual(Result.invalid_value, grid_ref_hyperlink_equal(&a, null, &equal));
+    try testing.expectEqual(Result.invalid_value, grid_ref_hyperlink_equal(&a, &b, null));
+    try testing.expectEqual(Result.success, grid_ref_hyperlink_equal(&a, &b, &equal));
+    try testing.expect(equal);
+    try testing.expectEqual(Result.success, grid_ref_hyperlink_equal(&a, &c, &equal));
+    try testing.expect(!equal);
+    try testing.expectEqual(Result.success, grid_ref_hyperlink_equal(&missing, &missing, &equal));
+    try testing.expect(!equal);
+}
