+
+test "format_mapped preserves native PinMap and propagates callbacks" {
+    const Visit = struct {
+        bytes: []const u8,
+        map: *const formatterpkg.PinMap.Map,
+        offset: usize = 0,
+        calls: usize = 0,
+        fail: bool = false,
+        fn visit(ctx: ?*anyopaque, ref: *const grid_ref.CGridRef, bytes: [*]const u8, len: usize, offset: usize) callconv(lib.calling_conv) Result {
+            const self: *@This() = @ptrCast(@alignCast(ctx.?));
+            self.calls += 1;
+            if (self.fail) return .io_error;
+            testing.expectEqual(self.offset, offset) catch return .invalid_value;
+            testing.expectEqualSlices(u8, self.bytes[offset..][0..len], bytes[0..len]) catch return .invalid_value;
+            for (offset..offset + len) |i| {
+                const pin = self.map.get(i) orelse return .invalid_value;
+                testing.expectEqualDeep(grid_ref.CGridRef.fromPin(pin), ref.*) catch return .invalid_value;
+            }
+            self.offset += len;
+            return .success;
+        }
+    };
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &t, 8, 2));
+    defer terminal_c.free(t);
+    const input = "history\r\nwide界e\u{0301}\r\nlast";
+    terminal_c.vt_write(t, input.ptr, input.len);
+    var f: Formatter = null;
+    try testing.expectEqual(Result.success, terminal_new(&lib.alloc.test_allocator, &f, t));
+    defer free(f);
+    const screen = t.?.terminal.screens.active;
+    var selection = CSelection.fromZig(.init(screen.pages.pin(.{ .screen = .{} }).?, screen.pages.pin(.{ .active = .{ .x = 3, .y = 1 } }).?, false));
+    try testing.expectEqual(Result.success, set(f, .selection, &selection));
+    var native = terminalFormatter(f.?).*;
+    var writer: std.Io.Writer.Allocating = .init(testing.allocator);
+    defer writer.deinit();
+    var map: formatterpkg.PinMap.Map = .empty;
+    defer map.deinit(testing.allocator);
+    native.pin_map = .{ .alloc = testing.allocator, .map = &map };
+    try native.format(&writer.writer);
+    var visit: Visit = .{ .bytes = writer.writer.buffered(), .map = &map };
+    try testing.expect(visit.bytes.len > 0);
+    try testing.expectEqual(Result.invalid_value, format_mapped(null, Visit.visit, &visit));
+    try testing.expectEqual(Result.invalid_value, format_mapped(f, null, &visit));
+    try testing.expectEqual(Result.success, format_mapped(f, Visit.visit, &visit));
+    try testing.expectEqual(visit.bytes.len, visit.offset);
+    try testing.expect(terminalFormatter(f.?).pin_map == null);
+    visit.fail = true;
+    visit.calls = 0;
+    try testing.expectEqual(Result.io_error, format_mapped(f, Visit.visit, &visit));
+    try testing.expectEqual(@as(usize, 1), visit.calls);
+    const html: Format = .html;
+    try testing.expectEqual(Result.success, set(f, .emit, &html));
+    try testing.expectEqual(Result.invalid_value, format_mapped(f, Visit.visit, &visit));
+}
