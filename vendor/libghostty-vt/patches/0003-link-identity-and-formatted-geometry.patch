diff --git a/src/terminal/c/formatter.zig b/src/terminal/c/formatter.zig
index fe7615c..0a5aa65 100644
--- a/src/terminal/c/formatter.zig
+++ b/src/terminal/c/formatter.zig
@@ -301,6 +301,50 @@ pub fn format(
     return .io_error;
 }
 
+pub const MappedFn = *const fn (
+    ?*anyopaque,
+    *const grid_ref.CGridRef,
+    [*]const u8,
+    usize,
+    usize,
+) callconv(lib.calling_conv) Result;
+
+pub fn format_mapped(
+    formatter_: Formatter,
+    callback: ?MappedFn,
+    userdata: ?*anyopaque,
+) callconv(lib.calling_conv) Result {
+    if (comptime !lib.feature(.formatter) or !lib.feature(.grid_introspection)) return .unsupported;
+    const wrapper = formatter_ orelse return .invalid_value;
+    const visit = callback orelse return .invalid_value;
+    // Use a copy so the formatter never retains the stack-owned PinMap.
+    var formatter = terminalFormatter(wrapper).*;
+    if (formatter.opts.emit != .plain) return .invalid_value;
+    const alloc = wrapper.alloc;
+    var writer: std.Io.Writer.Allocating = .init(alloc);
+    defer writer.deinit();
+    var map: formatterpkg.PinMap.Map = .empty;
+    defer map.deinit(alloc);
+    formatter.pin_map = .{ .alloc = alloc, .map = &map };
+    formatter.format(&writer.writer) catch return .out_of_memory;
+    const bytes = writer.writer.buffered();
+    if (map.count() != bytes.len) return .invalid_value;
+    var offset: usize = 0;
+    while (offset < bytes.len) {
+        const pin = map.get(offset) orelse return .invalid_value;
+        var end = offset + 1;
+        while (end < bytes.len) : (end += 1) {
+            const other = map.get(end) orelse return .invalid_value;
+            if (pin.node != other.node or pin.x != other.x or pin.y != other.y) break;
+        }
+        const ref = grid_ref.CGridRef.fromPin(pin);
+        const result = visit(userdata, &ref, bytes[offset..end].ptr, end - offset, offset);
+        if (result != .success) return result;
+        offset = end;
+    }
+    return .success;
+}
