+/**
+ * SSHApp prototype extension: format plain text and visit contiguous byte runs
+ * mapped to their source cell by the native formatter. Offscreen cells are
+ * included. Runs are ordered, with absolute byte offsets into the formatted
+ * text. Empty output invokes no callbacks. A callback error stops enumeration.
+ * Only plain output is supported. Uses the formatter's current selection,
+ * trim and unwrap settings. NULL handles/callbacks return GHOSTTY_INVALID_VALUE.
+ * GHOSTTY_UNSUPPORTED is returned when formatter or grid introspection is disabled.
+ * All pointers expire when the callback returns. The terminal must remain
+ * exclusively borrowed for the whole call; callbacks may query fresh refs but
+ * must not mutate the terminal or formatter. Copy needed values.
+ */
+typedef GhosttyResult (*GhosttyFormatterMappedFn)(
+    void *userdata, const GhosttyGridRef *ref, const uint8_t *bytes,
+    size_t len, size_t offset);
+GHOSTTY_API GhosttyResult ghostty_formatter_format_mapped(
+    GhosttyFormatter formatter,
+    GhosttyFormatterMappedFn callback, void *userdata);
+
