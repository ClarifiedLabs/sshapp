+test "ignore DEC cursor blink mode without suppressing DECSCUSR" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 80, 24));
+    defer free(t);
+    const ignore = true;
+    try testing.expectEqual(Result.success, set(t, .ignore_cursor_blink_mode, &ignore));
+    vt_write(t, "\x1b[?12h", 6);
+    try testing.expect(!t.?.terminal.modes.get(.cursor_blinking));
+    vt_write(t, "\x1b[3 q", 5);
+    try testing.expect(t.?.terminal.modes.get(.cursor_blinking));
+    vt_write(t, "\x1b[?12l", 6);
+    try testing.expect(t.?.terminal.modes.get(.cursor_blinking));
+    reset(t);
+    vt_write(t, "\x1b[?12h", 6);
+    try testing.expect(!t.?.terminal.modes.get(.cursor_blinking));
+    try testing.expectEqual(Result.success, set(t, .ignore_cursor_blink_mode, null));
+    vt_write(t, "\x1b[?12h", 6);
+    try testing.expect(t.?.terminal.modes.get(.cursor_blinking));
+}
