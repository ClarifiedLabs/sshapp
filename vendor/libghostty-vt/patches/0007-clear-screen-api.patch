+    const screen = t.screens.active;
+    const storage = &screen.kitty_images;
+    for ([_]u32{ 1, 2, 3 }) |id| {
+        try storage.addImage(io, alloc, screen, .{
+            .id = id,
+            .width = 1,
+            .height = 1,
+            .data = .{ .complete = try alloc.dupe(u8, &.{ 0, 0, 0, 0 }) },
+        });
+    }
+    // An orphan and its child must not keep either image alive. A virtual
+    // placement (and its image) survives the host-only cleanup.
+    for ([_]u32{ 1, 2 }) |id| {
+        try storage.addPlacement(io, alloc, screen, id, 1, .{
+            .location = .{ .relative = .{ .parent = .{
+                .image_id = id - 1,
+                .placement_id = .{ .tag = .external, .id = 1 },
+            } } },
+        });
+    }
+    try storage.addPlacement(io, alloc, screen, 3, 1, .{ .location = .virtual });
+    try testing.expectEqual(@as(u32, 3), storage.placements.count());
+    try testing.expectEqual(@as(usize, 12), storage.total_bytes);
+    storage.clearHostScreen(io, alloc, screen);
+    try testing.expectEqual(@as(u32, 1), storage.placements.count());
+    try testing.expectEqual(@as(u32, 1), storage.images.count());
