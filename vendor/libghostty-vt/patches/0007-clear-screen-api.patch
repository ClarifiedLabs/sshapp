+/// Emulator-level Cmd+K clear, always clearing history without writing to the PTY.
+/// Never enters the persistent parser: a host action must not consume or reset
+/// a partially received escape sequence or UTF-8 codepoint.
+pub fn clear_screen(
+    terminal_: Terminal,
+    out_handled: ?*bool,
+    out_needs_form_feed: ?*bool,
+) callconv(lib.calling_conv) Result {
+    const t = (terminal_ orelse return .invalid_value).terminal;
+    const handled = out_handled orelse return .invalid_value;
+    const needs_form_feed = out_needs_form_feed orelse return .invalid_value;
+    handled.* = false;
+    needs_form_feed.* = false;
+    if (t.screens.active_key == .alternate) return .success;
+
+    t.screens.active.clearSelection();
+    t.eraseDisplay(.scrollback, false);
+    handled.* = true;
+    if (!t.cursorIsAtPrompt()) {
+        if (t.screens.active.cursor.y > 0) {
+            t.screens.active.eraseActive(t.screens.active.cursor.y - 1);
+        }
+        if (comptime build_options.kitty_graphics) {
+            t.screens.active.kitty_images.clearHostScreen(
+                t.io(),
+                t.screens.active.alloc,
+                t.screens.active,
+            );
+        }
+        return .success;
+    }
+
+    // Preserve native prompt heuristics, including any scrollClear behavior.
+    // The host owns sending FF; no callback or synthetic VT input is used here.
+    t.eraseDisplay(.complete, false);
+    // Native ED2 preserves images moved into history by the prompt heuristic;
+    // host Cmd+K must remove those nonvirtual placements as well.
+    if (comptime build_options.kitty_graphics) {
+        t.screens.active.kitty_images.clearHostScreen(
+            t.io(),
+            t.screens.active.alloc,
+            t.screens.active,
+        );
+    }
+    needs_form_feed.* = true;
+    return .success;
+}
