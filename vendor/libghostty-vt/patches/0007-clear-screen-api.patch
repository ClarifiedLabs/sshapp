+    /// Host Cmd+K parity with the pre-VT terminal: remove ALL nonvirtual
+    /// placements (including history and relative placements), then sweep
+    /// unused images. This intentionally differs from protocol d=A and ED2.
+    /// Keep virtual placements and the independent in-progress loading image.
+    pub fn clearHostScreen(
+        self: *ImageStorage,
+        io: std.Io,
+        alloc: Allocator,
+        s: *terminal.Screen,
+    ) void {
+        const placements_before = self.placements.count();
+        const images_before = self.images.count();
+        var it = self.placements.iterator();
+        while (it.next()) |entry| {
+            switch (entry.value_ptr.location) {
+                .virtual => continue,
+                .pin, .relative => self.removePlacement(s, entry),
