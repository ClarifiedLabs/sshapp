+/**
+ * Perform an emulator-level clear (Cmd+K), not a terminal reset or VT input.
+ *
+ * On the alternate screen this succeeds without changing terminal state and
+ * sets both outputs to false. On the primary screen it always clears selection
+ * and scrollback, removes all nonvirtual Kitty placements, and reclaims unused
+ * images. Away from a prompt it removes rows above the cursor.
+ * At a prompt it uses native erase-display-complete behavior (including its
+ * prompt scrollback heuristic) and sets out_needs_form_feed to true so the
+ * host can send FF (0x0C) to the shell. This function never invokes a write
+ * callback or injects parser input. Modes and partial parser state survive.
+ *
+ * All three pointers must be non-NULL. Invalid arguments return
+ * GHOSTTY_INVALID_VALUE without changing terminal state or either output.
+ * On success out_handled is true only on the primary screen.
+ *
+ * @ingroup terminal
+ */
+GHOSTTY_API GhosttyResult ghostty_terminal_clear_screen(
+    GhosttyTerminal terminal,
+    bool *out_handled,
+    bool *out_needs_form_feed);
