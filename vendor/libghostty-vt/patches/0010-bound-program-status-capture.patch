+test "Parser OSC 7501 limit does not restrict OSC 52" {
+    const testing = std.testing;
+    @setEvalBranchQuota(10_000);
+    const data: [2048 * "YWFh".len]u8 = std.simd.repeat(2048 * "YWFh".len, "YWFh".*);
+    for ([_]bool{ false, true }) |per_byte| {
+        var p: Parser = .init(testing.allocator);
+        defer p.deinit();
+        const input = "52;c;" ++ data;
+        if (per_byte) {
+            for (input) |ch| p.next(ch);
+        } else {
+            p.nextSlice(input);
+        }
+        try testing.expect(p.capture.?.trailing().len > 4096);
+        try testing.expectEqualStrings(&data, p.end(null).?.clipboard_contents.data);
+    }
+}
