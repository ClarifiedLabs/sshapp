+test "Parser OSC 7501 configured cap and fixed fallback" {
+    const testing = std.testing;
+    var failing: testing.FailingAllocator = .init(testing.allocator, .{ .fail_index = 0 });
+    const allocators = [_]?Allocator{ testing.allocator, null, failing.allocator() };
+    const padding: [parsers.program_status.max_body_bytes]u8 = @splat('a');
+
+    for (allocators, 0..) |alloc, i| {
+        for ([_]usize{ 0, 1, 64, Parser.MAX_BUF + 1, Parser.MAX_ALLOCATING_BUF }) |configured| {
+            for ([_]bool{ false, true }) |per_byte| {
+                var p: Parser = .init(alloc);
+                defer p.deinit();
+                p.max_allocating_bytes = configured;
+                const limit = @min(configured, if (i == 0)
+                    parsers.program_status.max_body_bytes
+                else
+                    Parser.MAX_BUF);
+                const body = padding[0..limit];
+                if (per_byte) {
+                    for ("7501;") |ch| p.next(ch);
+                    for (body) |ch| p.next(ch);
+                } else {
+                    p.nextSlice("7501;");
+                    p.nextSlice(body);
+                }
+                const cap = &p.capture.?;
+                try testing.expectEqual(Parser.State.@"7501", p.state);
+                try testing.expectEqual(limit, cap.trailing().len);
+                try testing.expectEqual(limit, cap.writer.buffer.len);
+                if (i == 1 or (i == 2 and limit > 0)) try testing.expect(cap.backing == .fixed);
+
+                if (per_byte) p.next('a') else p.nextSlice("a");
+                try testing.expectEqual(Parser.State.invalid, p.state);
+                try testing.expectEqual(limit, cap.trailing().len);
+                try testing.expectEqual(limit, cap.writer.buffer.len);
+                try testing.expect(p.end(null) == null);
+            }
+        }
+    }
+}
