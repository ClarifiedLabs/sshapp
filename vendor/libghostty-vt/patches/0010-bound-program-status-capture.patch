+test "Parser OSC 7501 capture limit and recovery" {
+    const testing = std.testing;
+    const limit = parsers.program_status.max_body_bytes;
+    const body_prefix = "state=working:padding=";
+    const body = body_prefix ++ @as([limit - body_prefix.len]u8, @splat('a'));
+    const input = "7501;" ++ body;
+    try testing.expectEqual(@as(usize, 4087), body.len);
+    try testing.expectEqual(@as(usize, 4096), ("\x1b]" ++ input ++ "\x1b\\").len);
+
+    // Whole slices, individual bytes, and splits within both prefix and body.
+    for ([_]usize{ input.len, 1, 3, Parser.MAX_BUF }) |chunk_size| {
+        var p: Parser = .init(testing.allocator);
+        defer p.deinit();
+
+        var offset: usize = 0;
+        while (offset < input.len) {
+            const end = @min(input.len, offset + chunk_size);
+            if (chunk_size == 1) p.next(input[offset]) else p.nextSlice(input[offset..end]);
+            offset = end;
+        }
+        const cap = &p.capture.?;
+        try testing.expectEqual(@as(usize, limit), cap.trailing().len);
+        try testing.expectEqual(@as(usize, limit), cap.writer.buffer.len);
+        const cmd = p.end(null).?;
+        try testing.expect(cmd.* == .program_status);
+        try testing.expect(cmd.program_status == .report);
+        try testing.expectEqual(.working, cmd.program_status.report.state);
+        try testing.expectEqualStrings(body, cmd.program_status.report.data);
+
+        // Overflow must invalidate immediately, without waiting for end().
+        if (chunk_size == 1) p.next('a') else p.nextSlice("a");
+        try testing.expectEqual(Parser.State.invalid, p.state);
+        try testing.expectEqual(@as(usize, limit), cap.trailing().len);
+        try testing.expectEqual(@as(usize, limit), cap.writer.buffer.len);
+
+        // An unterminated sequence cannot retain or allocate any more bytes.
+        const huge: [1024 * 1024]u8 = @splat('a');
+        p.nextSlice(&huge);
+        for (huge) |ch| p.next(ch);
+        try testing.expectEqual(Parser.State.invalid, p.state);
+        try testing.expectEqualStrings(body, cap.trailing());
+        try testing.expectEqual(@as(usize, limit), cap.writer.buffer.len);
+        try testing.expect(p.end(null) == null);
+
+        p.reset();
+        try testing.expect(p.capture == null);
+        p.nextSlice("2;recovered");
+        try testing.expectEqualStrings("recovered", p.end(0x07).?.change_window_title);
+        p.reset();
+        p.nextSlice("7501;state=idle");
+        try testing.expectEqual(.idle, p.end(null).?.program_status.report.state);
+    }
+
+    // Overflow within one slice, including every possible two-way split.
+    const oversized = input ++ "a";
+    for (0..oversized.len + 1) |split| {
+        var p: Parser = .init(testing.allocator);
+        defer p.deinit();
+        p.nextSlice(oversized[0..split]);
+        p.nextSlice(oversized[split..]);
+        try testing.expectEqual(Parser.State.invalid, p.state);
+        try testing.expectEqualStrings(body, p.capture.?.trailing());
+        try testing.expectEqual(@as(usize, limit), p.capture.?.writer.buffer.len);
+        try testing.expect(p.end(null) == null);
+    }
+}
