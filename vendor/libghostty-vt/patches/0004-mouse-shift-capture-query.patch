+test "get remote mouse Shift capture and reset" {
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 80, 24));
+    defer free(t);
+    var capture = false;
+    try testing.expectEqual(Result.no_value, get(t, .mouse_shift_capture, @ptrCast(&capture)));
+    vt_write(t, "\x1b[>1s", 5);
+    try testing.expectEqual(Result.success, get(t, .mouse_shift_capture, @ptrCast(&capture)));
+    try testing.expect(capture);
+    vt_write(t, "\x1b[>0s", 5);
+    try testing.expectEqual(Result.success, get(t, .mouse_shift_capture, @ptrCast(&capture)));
+    try testing.expect(!capture);
+    reset(t);
+    try testing.expectEqual(Result.no_value, get(t, .mouse_shift_capture, @ptrCast(&capture)));
+}
