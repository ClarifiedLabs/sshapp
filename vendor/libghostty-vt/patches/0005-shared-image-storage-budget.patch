+test "shared image budget validates configuration and survives reset" {
+    const State = struct {
+        used: usize = 0,
+        fn reserve(ctx: ?*anyopaque, bytes: usize) callconv(.c) bool {
+            const self: *@This() = @ptrCast(@alignCast(ctx.?));
+            self.used += bytes;
+            return true;
+        }
+        fn release(ctx: ?*anyopaque, bytes: usize) callconv(.c) void {
+            const self: *@This() = @ptrCast(@alignCast(ctx.?));
+            self.used -= bytes;
+        }
+    };
+    var state: State = .{};
+    var budget: ImageBudget = .{ .userdata = &state, .reserve = State.reserve, .release = State.release };
+    var t: Terminal = null;
+    try testing.expectEqual(Result.success, new(&lib.alloc.test_allocator, &t, 8, 4));
+    defer free(t);
+    budget.size = @sizeOf(usize);
+    try testing.expectEqual(Result.invalid_value, set(t, .kitty_image_budget, &budget));
+    budget.size = @sizeOf(ImageBudget);
+    budget.release = null;
+    try testing.expectEqual(Result.invalid_value, set(t, .kitty_image_budget, &budget));
+    budget.release = State.release;
+    try testing.expectEqual(Result.success, set(t, .kitty_image_budget, &budget));
+    const image = "\x1b_Ga=t,f=32,s=1,v=1,i=1;AQID/w==\x1b\\";
+    vt_write(t, image, image.len);
+    try testing.expectEqual(@as(usize, 4), state.used);
+    try testing.expectEqual(Result.invalid_value, set(t, .kitty_image_budget, null));
+    const alternate = "\x1b[?1049h";
+    vt_write(t, alternate, alternate.len);
+    // Even with an empty active screen, a nonempty primary prevents rebinding.
+    try testing.expectEqual(Result.invalid_value, set(t, .kitty_image_budget, null));
+    vt_write(t, image, image.len);
+    try testing.expectEqual(@as(usize, 8), state.used);
+    reset(t);
+    try testing.expectEqual(@as(usize, 0), state.used);
+    vt_write(t, image, image.len);
+    try testing.expectEqual(@as(usize, 4), state.used);
+    const zero: u64 = 0;
+    try testing.expectEqual(Result.success, set(t, .kitty_image_storage_limit, &zero));
+    try testing.expectEqual(@as(usize, 0), state.used);
+    const limit: u64 = 100;
+    try testing.expectEqual(Result.success, set(t, .kitty_image_storage_limit, &limit));
+    // Refuse rebinding while a chunked image is loading but not yet stored.
+    const chunk = "\x1b_Ga=t,f=32,s=1,v=1,i=1,m=1;AQID\x1b\\";
+    vt_write(t, chunk, chunk.len);
+    try testing.expectEqual(Result.invalid_value, set(t, .kitty_image_budget, null));
+    reset(t);
+    try testing.expectEqual(Result.success, set(t, .kitty_image_budget, null));
+    vt_write(t, image, image.len);
+    try testing.expectEqual(@as(usize, 0), state.used);
+}
