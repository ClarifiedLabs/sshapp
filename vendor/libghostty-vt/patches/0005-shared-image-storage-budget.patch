+test "storage: shared budget pending replacement and eviction accounting" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+    var budget: TestSharedBudget = .{ .limit = 8 };
+    var t = try terminal.Terminal.init(io, alloc, .{ .cols = 8, .rows = 4 });
+    defer t.deinit(alloc);
+    var first: ImageStorage = .{ .budget = budget.value(), .total_limit = 4 };
+    defer first.deinit(alloc, t.screens.active);
+    var second: ImageStorage = .{ .budget = budget.value() };
+    defer second.deinit(alloc, t.screens.active);
+    try first.addImage(io, alloc, t.screens.active, .{ .id = 1, .data = .{ .pending = 4 } });
+    try second.addImage(io, alloc, t.screens.active, .{ .id = 1, .data = .{ .pending = 4 } });
+    try testing.expectEqual(@as(usize, 8), budget.used);
+    const original = first.imageById(1).?.generation;
+    // Same-size replacements consume no new quota, even when full.
+    try first.addImage(io, alloc, t.screens.active, .{ .id = 1, .data = .{ .pending = 4 } });
+    try testing.expect(first.imageById(1).?.generation != original);
+    // Shared refusal occurs before local eviction and preserves old content.
+    const generation = first.imageById(1).?.generation;
+    try testing.expectError(error.OutOfMemory, first.addImage(io, alloc, t.screens.active, .{ .id = 2, .data = .{ .pending = 4 } }));
+    try testing.expectEqual(generation, first.imageById(1).?.generation);
+    try testing.expectEqual(@as(usize, 8), budget.used);
+    // Shrinking credits the difference; later local eviction releases bytes.
+    try second.addImage(io, alloc, t.screens.active, .{ .id = 1, .data = .{ .pending = 1 } });
+    try first.addImage(io, alloc, t.screens.active, .{ .id = 2, .data = .{ .pending = 3 } });
+    try testing.expect(first.imageById(1) == null);
+    try testing.expectEqual(@as(usize, 4), budget.used);
+    first.setLimit(io, alloc, t.screens.active, 0);
+    try testing.expectEqual(@as(usize, 1), budget.used);
+    try testing.expect(first.budget != null);
+    second.setLimit(io, alloc, t.screens.active, 0);
+    try testing.expectEqual(@as(usize, 0), budget.used);
+}
