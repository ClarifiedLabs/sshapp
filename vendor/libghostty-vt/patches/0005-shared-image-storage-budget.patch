+
+const TestSharedBudget = struct {
+    limit: usize,
+    used: usize = 0,
+    denied: usize = 0,
+
+    fn value(self: *TestSharedBudget) ImageStorage.Budget {
+        return .{ .userdata = self, .reserve = reserve, .release = release };
+    }
+    fn reserve(ctx: ?*anyopaque, bytes: usize) callconv(.c) bool {
+        const self: *TestSharedBudget = @ptrCast(@alignCast(ctx.?));
+        if (bytes > self.limit - self.used) {
+            self.denied += 1;
+            return false;
+        }
+        self.used += bytes;
+        return true;
+    }
+    fn release(ctx: ?*anyopaque, bytes: usize) callconv(.c) void {
+        const self: *TestSharedBudget = @ptrCast(@alignCast(ctx.?));
+        std.debug.assert(bytes <= self.used);
+        self.used -= bytes;
+    }
+};
