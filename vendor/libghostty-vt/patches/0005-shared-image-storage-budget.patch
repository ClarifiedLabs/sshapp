    * Input type: bool*. NULL restores the built-in false (honor mode 12).
    */
   GHOSTTY_TERMINAL_OPT_IGNORE_CURSOR_BLINK_MODE = 44,
+  /**
+   * SSHApp prototype extension: optional shared retained-image quota.
+   * Input: GhosttyKittyImageBudget*. NULL removes the quota. The value is
+   * copied. Invalid callbacks/size, or any screen with stored/loading images,
+   * return GHOSTTY_INVALID_VALUE without changing the previous configuration.
+   * Inherited by new screens and preserved by RIS and graphics disable/enable.
+   */
+  GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_BUDGET = 45,
   GHOSTTY_TERMINAL_OPT_MAX_VALUE = GHOSTTY_ENUM_MAX_VALUE,
 } GhosttyTerminalOption;

