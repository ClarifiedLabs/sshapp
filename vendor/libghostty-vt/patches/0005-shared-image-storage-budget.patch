@@ -1616,6 +1616,34 @@ typedef struct {
   bool value;
 } GhosttyTerminalModeConfig;

+/**
+ * SSHApp prototype extension, not part of the unmodified upstream pin.
+ * Optional shared quota for retained Kitty image pixel bytes, including
+ * pending image reservations and animation frames. Loading/decoding buffers,
+ * metadata, host snapshots and renderer storage are not charged.
+ *
+ * reserve must atomically charge bytes and return true, or return false without
+ * a charge. release returns an earlier charge. Zero byte operations are omitted.
+ * Storage replacements reserve net growth; shrinking/deleting returns bytes.
+ * Wire retransmission deletes the old ID when loading begins, as usual, so its
+ * released bytes may be claimed by other terminals. Refusal does not restore
+ * that image. Unrelated stored images are not evicted by quota refusal.
+ * Refusal returns a protocol resource error and following bytes still process.
+ * The per-screen storage limit still applies independently. A shared refusal
+ * never evicts images, even if local-limit eviction could have created room.
+ *
+ * Both callbacks must be non-NULL, thread-safe, synchronous, non-reentrant and
+ * must not call terminal APIs. They may run during terminal destruction. The
+ * host owns userdata and must keep it valid until all configured terminals are
+ * freed (or their empty stores have been unconfigured).
+ */
+typedef struct {
+  size_t size;
+  void *userdata;
+  bool (*reserve)(void *userdata, size_t bytes);
+  void (*release)(void *userdata, size_t bytes);
+} GhosttyKittyImageBudget;
+
 /**
  * Terminal option identifiers.
  *
