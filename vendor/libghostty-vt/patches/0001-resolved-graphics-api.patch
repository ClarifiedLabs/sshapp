diff --git a/src/terminal/c/kitty_graphics.zig b/src/terminal/c/kitty_graphics.zig
index 2bd5e862..798532a3 100644
--- a/src/terminal/c/kitty_graphics.zig
+++ b/src/terminal/c/kitty_graphics.zig
@@ -2136,3 +2136,170 @@ test "generation never recurs across resets and screen switches" {
     try testing.expectEqual(Result.success, get(graphics, .generation, @ptrCast(&gen)));
     try testing.expect(gen > gen_alt);
 }
+
+/// SSHApp prototype API extension. Resolves terminal graphics semantics without
+/// linking any full-renderer code. The callback may query images but must not
+/// mutate the terminal or retain this stack-owned descriptor.
+pub const RenderPlacement = extern struct {
+    size: usize = @sizeOf(RenderPlacement),
+    image_id: u32,
+    placement_id: u32,
+    placement_id_is_internal: bool,
+    is_unicode: bool = false,
+    column: i32,
+    row: i32,
+    z: i32,
+    offset_x: f64,
+    offset_y: f64,
+    pixel_width: f64,
+    pixel_height: f64,
+    source_x: f64,
+    source_y: f64,
+    source_width: f64,
+    source_height: f64,
+};
+
+pub const RenderFn = *const fn (?*anyopaque, *const RenderPlacement) callconv(lib.calling_conv) Result;
+
+pub fn render_iterate(
+    terminal_: terminal_c.Terminal,
+    callback_: ?RenderFn,
+    userdata: ?*anyopaque,
+    virtual_count: ?*usize,
+) callconv(lib.calling_conv) Result {
+    if (comptime !build_options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const callback = callback_ orelse return .invalid_value;
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    const alloc = lib.alloc.default(null);
+    const unicode = @import("../kitty/graphics_unicode.zig");
+    const Storage = kitty_storage.ImageStorage;
+    const Origin = struct { x: i32, y: i32 };
+    var origins: std.AutoHashMapUnmanaged(Storage.PlacementKey, Origin) = .empty;
+    defer origins.deinit(alloc);
+
+    var virtuals: usize = 0;
+    var relatives = false;
+    var it = storage.placements.iterator();
+    while (it.next()) |entry| switch (entry.value_ptr.location) {
+        .virtual => virtuals += 1,
+        .relative => relatives = true,
+        .pin => {},
+    };
+    if (virtual_count) |out| out.* = virtuals;
+    if (t.cols == 0 or t.rows == 0) return .invalid_value;
+    const cw: u32 = t.width_px / t.cols;
+    const ch: u32 = t.height_px / t.rows;
+    if (cw == 0 or ch == 0) return .success;
+
+    if (virtuals > 0) {
+        const pages = &t.screens.active.pages;
+        const bottom = pages.getBottomRight(.viewport) orelse return .success;
+        var placeholders = unicode.placementIterator(pages.getTopLeft(.viewport), bottom);
+        while (placeholders.next()) |run| {
+            const target = storage.placeholderTarget(run.image_id, run.placement_id) orelse continue;
+            const vp = pages.pointFromPin(.viewport, run.pin) orelse continue;
+            // The origin is the minimum visible placeholder cell, not the
+            // source fragment's offset or the image's aspect-fit inset.
+            if (relatives) {
+                const gop = origins.getOrPut(alloc, target.key) catch return .out_of_memory;
+                const origin: Origin = .{ .x = @intCast(vp.viewport.x), .y = @intCast(vp.viewport.y) };
+                if (!gop.found_existing) gop.value_ptr.* = origin else {
+                    gop.value_ptr.x = @min(gop.value_ptr.x, origin.x);
+                    gop.value_ptr.y = @min(gop.value_ptr.y, origin.y);
+                }
+            }
+            const img = storage.imageById(run.image_id) orelse continue;
+            if (img.renderData().bytes() == null or img.width == 0 or img.height == 0) continue;
+            const cols = if (target.placement.columns > 0) target.placement.columns else (img.width + cw - 1) / cw;
+            const rows = if (target.placement.rows > 0) target.placement.rows else (img.height + ch - 1) / ch;
+            if (cols == 0 or rows == 0) continue;
+
+            // Intersect this cell run with the image fitted into the virtual
+            // grid. Keep fractional source pixels: rounding each row to an
+            // integer source rectangle loses tiny images enlarged over rows.
+            const grid_w = @as(f64, @floatFromInt(cols)) * @as(f64, @floatFromInt(cw));
+            const grid_h = @as(f64, @floatFromInt(rows)) * @as(f64, @floatFromInt(ch));
+            const iw: f64 = @floatFromInt(img.width);
+            const ih: f64 = @floatFromInt(img.height);
+            const scale = @min(grid_w / iw, grid_h / ih);
+            const image_x = (grid_w - iw * scale) / 2;
+            const image_y = (grid_h - ih * scale) / 2;
+            const run_x = @as(f64, @floatFromInt(run.col)) * @as(f64, @floatFromInt(cw));
+            const run_y = @as(f64, @floatFromInt(run.row)) * @as(f64, @floatFromInt(ch));
+            const left = @max(run_x, image_x);
+            const top = @max(run_y, image_y);
+            const right = @min(run_x + @as(f64, @floatFromInt(run.width)) * @as(f64, @floatFromInt(cw)), image_x + iw * scale);
+            const end = @min(run_y + @as(f64, @floatFromInt(run.height)) * @as(f64, @floatFromInt(ch)), image_y + ih * scale);
+            if (right <= left or end <= top) continue;
+            const placement: RenderPlacement = .{
+                .image_id = run.image_id,
+                .placement_id = target.key.placement_id.id,
+                .placement_id_is_internal = target.key.placement_id.tag == .internal,
+                .is_unicode = true,
+                .column = @intCast(vp.viewport.x),
+                .row = @intCast(vp.viewport.y),
+                .z = -1,
+                .offset_x = left - run_x,
+                .offset_y = top - run_y,
+                .pixel_width = right - left,
+                .pixel_height = end - top,
+                .source_x = (left - image_x) / scale,
+                .source_y = (top - image_y) / scale,
+                .source_width = (right - left) / scale,
+                .source_height = (end - top) / scale,
+            };
+            const result = callback(userdata, &placement);
+            if (result != .success) return result;
+        }
+    }
+
+    it = storage.placements.iterator();
+    while (it.next()) |entry| {
+        const p = entry.value_ptr;
+        if (p.location == .virtual) continue;
+        const img = storage.imageById(entry.key_ptr.image_id) orelse continue;
+        if (img.renderData().bytes() == null) continue;
+        var vp = computeViewportPos(p, &img, t);
+        if (p.location == .relative) {
+            const chain = storage.resolveChain(p.location.relative) orelse continue;
+            if (chain.root.location == .virtual) {
+                const origin = origins.get(chain.root_key) orelse continue;
+                const x = @as(i64, origin.x) + chain.horizontal_offset;
+                const y = @as(i64, origin.y) + chain.vertical_offset;
+                const grid = p.gridSize(img, t);
+                if (x >= t.cols or y >= t.rows or x + grid.cols <= 0 or y + grid.rows <= 0) continue;
+                vp = .{
+                    .col = std.math.cast(i32, x) orelse continue,
+                    .row = std.math.cast(i32, y) orelse continue,
+                    .visible = true,
+                };
+            }
+        }
+        if (!vp.visible) continue;
+        const size = p.pixelSize(img, t);
+        const source = p.sourceRect(img);
+        const offset = p.cellOffset(t);
+        if (size.width == 0 or size.height == 0 or source.width == 0 or source.height == 0) continue;
+        const placement: RenderPlacement = .{
+            .image_id = entry.key_ptr.image_id,
+            .placement_id = entry.key_ptr.placement_id.id,
+            .placement_id_is_internal = entry.key_ptr.placement_id.tag == .internal,
+            .column = vp.col,
+            .row = vp.row,
+            .z = p.z,
+            .offset_x = @floatFromInt(offset.x),
+            .offset_y = @floatFromInt(offset.y),
+            .pixel_width = @floatFromInt(size.width),
+            .pixel_height = @floatFromInt(size.height),
+            .source_x = @floatFromInt(source.x),
+            .source_y = @floatFromInt(source.y),
+            .source_width = @floatFromInt(source.width),
+            .source_height = @floatFromInt(source.height),
+        };
+        const result = callback(userdata, &placement);
+        if (result != .success) return result;
+    }
+    return .success;
+}
