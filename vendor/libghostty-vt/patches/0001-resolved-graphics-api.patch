@@ -862,6 +862,34 @@ GHOSTTY_API GhosttyResult ghostty_kitty_graphics_placement_render_info(
     GhosttyTerminal terminal,
     GhosttyKittyGraphicsPlacementRenderInfo* out_info);

+/**
+ * SSHApp prototype extension, not part of the unmodified upstream pin.
+ * Synchronous enumeration of visible regular, Unicode-placeholder and relative
+ * placements. The terminal must remain exclusively borrowed for this call.
+ * A callback may query images, but must not mutate the terminal or re-enter this
+ * enumeration. Descriptor pointers expire when the callback returns; copy them.
+ * Pixel/image coordinates retain fractions when a source texel spans many cells.
+ * The callback's first non-success result stops enumeration and is propagated.
+ * The optional count reports stored virtual templates, including offscreen ones.
+ * Ordering is unspecified; sort by z and image ID before drawing.
+ */
+#define GHOSTTY_SSHAPP_RESOLVED_GRAPHICS 1
+typedef struct {
+    size_t size;
+    uint32_t image_id, placement_id;
+    bool placement_id_is_internal, is_unicode;
+    int32_t column, row, z;
+    double offset_x, offset_y, pixel_width, pixel_height;
+    double source_x, source_y, source_width, source_height;
+} GhosttyKittyGraphicsRenderPlacement;
+
+typedef GhosttyResult (*GhosttyKittyGraphicsRenderFn)(
+    void* userdata, const GhosttyKittyGraphicsRenderPlacement* placement);
+
+GHOSTTY_API GhosttyResult ghostty_kitty_graphics_render_iterate(
+    GhosttyTerminal terminal, GhosttyKittyGraphicsRenderFn callback,
+    void* userdata, size_t* virtual_count);
+
 /** @} */

