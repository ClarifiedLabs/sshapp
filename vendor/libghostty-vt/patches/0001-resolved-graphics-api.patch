+
+/// SSHApp prototype API extension. Resolves terminal graphics semantics without
+/// linking any full-renderer code. The callback may query images but must not
+/// mutate the terminal or retain this stack-owned descriptor.
+pub const RenderPlacement = extern struct {
+    size: usize = @sizeOf(RenderPlacement),
+    image_id: u32,
+    placement_id: u32,
+    is_unicode: bool = false,
+    column: i32,
+    row: i32,
+    z: i32,
+    offset_x: f64,
+    offset_y: f64,
+    pixel_width: f64,
+    pixel_height: f64,
+    source_x: f64,
+    source_y: f64,
+    source_width: f64,
+    source_height: f64,
+};
+
+pub const RenderFn = *const fn (?*anyopaque, *const RenderPlacement) callconv(lib.calling_conv) Result;
+
+pub fn render_iterate(
+    state_: render_c.RenderState,
+    terminal_: terminal_c.Terminal,
+    callback_: ?RenderFn,
+    userdata: ?*anyopaque,
+    virtual_count: ?*usize,
+) callconv(lib.calling_conv) Result {
+    if (comptime !lib.feature(.kitty_graphics) or !lib.feature(.render_state)) return .unsupported;
+    const state = state_ orelse return .invalid_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const callback = callback_ orelse return .invalid_value;
+
+    const t = wrapper.terminal;
+    const storage = &t.screens.active.kitty_images;
+    if (virtual_count) |out| {
+        out.* = 0;
+        var placements = storage.placements.iterator();
+        while (placements.next()) |entry| {
+            if (entry.value_ptr.location == .virtual) out.* += 1;
+        }
+    }
+
+    if (t.cols == 0 or t.rows == 0) return .invalid_value;
+    const cw: u32 = t.width_px / t.cols;
+    const ch: u32 = t.height_px / t.rows;
+    var iterator = state.state.imagePlacementIterator();
+    if (cw > 0 and ch > 0) {
+        // The upstream iterator rounds each run's source rectangle to whole
+        // texels. An enlarged image can have less than half a texel per row,
+        // which rounds to zero. Resolve the raw runs with fractional geometry
+        // instead; keep upstream positioning for fixed and relative placements.
+        for (iterator.rows, 0..) |runs, y| {
+            for (runs.items) |run| {
+                const target = storage.placeholderTarget(run.image_id, run.placement_id) orelse continue;
+                const img = storage.imageById(run.image_id) orelse continue;
+                if (img.renderData().bytes() == null or img.width == 0 or img.height == 0) continue;
+                const cols = if (target.placement.columns > 0) target.placement.columns else (img.width - 1) / cw + 1;
+                const rows = if (target.placement.rows > 0) target.placement.rows else (img.height - 1) / ch + 1;
+                // Match upstream's representable placement grid bounds before
+                // calculating our fractional (rather than rounded) geometry.
+                if (cols > std.math.maxInt(u16) or rows > std.math.maxInt(u16) or
+                    run.col >= cols or run.row >= rows) continue;
+                const viewport_row = std.math.cast(i32, iterator.viewport_y_base +
+                    @as(isize, @intCast(y))) orelse continue;
+                const grid_w = @as(f64, @floatFromInt(cols)) * @as(f64, @floatFromInt(cw));
+                const grid_h = @as(f64, @floatFromInt(rows)) * @as(f64, @floatFromInt(ch));
+                const iw: f64 = @floatFromInt(img.width);
+                const ih: f64 = @floatFromInt(img.height);
+                const scale = @min(grid_w / iw, grid_h / ih);
+                const image_x = (grid_w - iw * scale) / 2;
+                const image_y = (grid_h - ih * scale) / 2;
+                const run_x = @as(f64, @floatFromInt(run.col)) * @as(f64, @floatFromInt(cw));
+                const run_y = @as(f64, @floatFromInt(run.row)) * @as(f64, @floatFromInt(ch));
+                const left = @max(run_x, image_x);
+                const top = @max(run_y, image_y);
+                const right = @min(run_x + @as(f64, @floatFromInt(run.width)) * @as(f64, @floatFromInt(cw)), image_x + iw * scale);
+                const bottom = @min(run_y + @as(f64, @floatFromInt(ch)), image_y + ih * scale);
+                if (right <= left or bottom <= top) continue;
+                const placement: RenderPlacement = .{
+                    .image_id = run.image_id,
+                    .placement_id = switch (target.key.placement_id.tag) {
+                        .external => target.key.placement_id.id,
+                        .internal => 0,
+                    },
+                    .is_unicode = true,
+                    .column = run.x,
+                    .row = viewport_row,
+                    .z = -1,
+                    .offset_x = left - run_x,
+                    .offset_y = top - run_y,
+                    .pixel_width = right - left,
+                    .pixel_height = bottom - top,
+                    .source_x = (left - image_x) / scale,
+                    .source_y = (top - image_y) / scale,
+                    .source_width = (right - left) / scale,
+                    .source_height = (bottom - top) / scale,
+                };
+                const result = callback(userdata, &placement);
+                if (result != .success) return result;
+            }
+        }
+    }
+    while (iterator.next()) |native| {
+        if (native.protocol.kitty.kind == .virtual) continue;
+        const placement: RenderPlacement = .{
+            .image_id = native.image_id,
+            .placement_id = native.protocol.kitty.placement_id,
+            .is_unicode = native.protocol.kitty.kind == .virtual,
+            .column = native.x,
+            .row = native.y,
+            .z = native.z,
+            .offset_x = @floatFromInt(native.offset_x),
+            .offset_y = @floatFromInt(native.offset_y),
+            .pixel_width = @floatFromInt(native.width),
+            .pixel_height = @floatFromInt(native.height),
+            .source_x = @floatFromInt(native.source_x),
+            .source_y = @floatFromInt(native.source_y),
+            .source_width = @floatFromInt(native.source_width),
+            .source_height = @floatFromInt(native.source_height),
+        };
+        const result = callback(userdata, &placement);
+        if (result != .success) return result;
+    }
+    return .success;
+}
+
+test "render_iterate keeps fractional source pixels and virtual template count" {
+    const Visit = struct {
+        calls: usize = 0,
+        fail: bool = false,
+        fn visit(ctx: ?*anyopaque, placement: *const RenderPlacement) callconv(lib.calling_conv) Result {
+            const self: *@This() = @ptrCast(@alignCast(ctx.?));
+            self.calls += 1;
+            if (self.fail) return .io_error;
+            testing.expect(placement.is_unicode) catch return .invalid_value;
+            testing.expect(placement.source_width > 0 and placement.source_width < 0.5) catch return .invalid_value;
+            testing.expect(placement.source_height > 0 and placement.source_height < 0.5) catch return .invalid_value;
+            return .success;
+        }
+    };
+    var t: terminal_c.Terminal = null;
+    try testing.expectEqual(Result.success, terminal_c.new(&lib.alloc.test_allocator, &t, 20, 20));
+    defer terminal_c.free(t);
+    try testing.expectEqual(Result.success, terminal_c.resize(t, 20, 20, 10, 10));
+    const input = "\x1b_Ga=T,f=32,s=1,v=1,i=1,U=1,c=16,r=16;AQID/w==\x1b\\" ++
+        "\x1b_Ga=T,f=32,s=1,v=1,i=2,U=1,c=16,r=16;AQID/w==\x1b\\" ++
+        "\x1b[38;2;0;0;1m\u{10EEEE}\u{0305}\u{0305}";
+    terminal_c.vt_write(t, input.ptr, input.len);
+    var state: render_c.RenderState = null;
+    try testing.expectEqual(Result.success, render_c.new(&lib.alloc.test_allocator, &state));
+    defer render_c.free(state);
+    try testing.expectEqual(Result.success, render_c.update(state, t));
+    var visit: Visit = .{};
+    var count: usize = 0;
+    try testing.expectEqual(Result.invalid_value, render_iterate(null, t, Visit.visit, &visit, &count));
+    try testing.expectEqual(Result.invalid_value, render_iterate(state, null, Visit.visit, &visit, &count));
+    try testing.expectEqual(Result.invalid_value, render_iterate(state, t, null, &visit, &count));
+    try testing.expectEqual(Result.success, render_iterate(state, t, Visit.visit, &visit, &count));
+    try testing.expectEqual(@as(usize, 1), visit.calls);
+    try testing.expectEqual(@as(usize, 2), count);
+    visit.calls = 0;
+    visit.fail = true;
+    try testing.expectEqual(Result.io_error, render_iterate(state, t, Visit.visit, &visit, null));
+    try testing.expectEqual(@as(usize, 1), visit.calls);
+}
